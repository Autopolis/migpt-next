# 填写所选模型服务的 API 地址、模型名和密钥。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
# 如使用本地代理，按实际端口取消注释。无需代理则保持注释。
# HTTPS_PROXY=http://127.0.0.1:6152
# HTTP_PROXY=http://127.0.0.1:6152
# NO_PROXY=localhost,127.0.0.1,.mi.com,.xiaomi.com
MI_USER_ID=
MI_PASSWORD=
MI_PASS_TOKEN=
MI_DID=
# 默认 MiNA 播报；仅在相应机型实测需要时填写，例如 5,1。
MI_TTS_COMMAND=
# 0: 手动说“打开连续对话”后开启；1: 启动时默认开启，仍须首次唤醒。
MI_CONTINUOUS_DIALOGUE=0
